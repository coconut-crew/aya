--[[
	AI generated implementation,
	with a human pass
]]

const fs = require("@std/fs")
const path = require("@std/path")
const pkg_id = require("@src/pkg/utils/pkg_id")
const semver = require("@src/pkg/utils/semver")
const yaml_luau = require("@pkg/yaml_luau")

export type Package = {
	version: semver.Identity,
	checksum: string,
}

export type Identity = { [pkg_id.GlobalName]: Package }

const LOCKFILE_NAME = ".aya.lock.yaml"
const FORMAT_VERSION = 1
const HEADER = "# autogenerated, do not edit by hand\n"

const lockfile = {}

function lockfile.parse(content: string): Identity
	const document = yaml_luau.deserialize(content)
	assert(type(document) == "table", "the lockfile must be a mapping")
	assert(
		document.lockfile_version == FORMAT_VERSION,
		`unsupported lockfile version {document.lockfile_version}, expected {FORMAT_VERSION}`
	)
	assert(type(document.packages) == "table", "packages must be a mapping")

	const locked: Identity = {}
	for name, raw in document.packages do
		assert(type(name) == "string", "locked package names must be strings")
		assert(type(raw) == "table", `{name}: the locked package must be a mapping`)
		assert(type(raw.version) == "string", `{name}: version must be a string`)
		assert(type(raw.checksum) == "string", `{name}: checksum must be a string`)

		locked[name] = { version = semver.parse(raw.version), checksum = raw.checksum }
	end

	return locked
end

function lockfile.serialize(locked: Identity): string
	-- { [package name]: yaml mapping }
	const packages: { [pkg_id.GlobalName]: unknown } = {}
	for name, pkg in locked do
		packages[name] = { version = semver.print(pkg.version), checksum = pkg.checksum }
	end

	return HEADER .. yaml_luau.serialize({ lockfile_version = FORMAT_VERSION, packages = packages })
end

function lockfile.read(dir: path.Pathlike): Identity?
	const location = path.join(dir, LOCKFILE_NAME)
	if not fs.exists(location) then
		return nil
	end

	return lockfile.parse(fs.readFileToString(location))
end

function lockfile.write_async(locked: Identity, dir: path.Pathlike)
	fs.writeStringToFile(path.join(dir, LOCKFILE_NAME), lockfile.serialize(locked))
end

-- the locked versions, in the form the resolver prefers them in
function lockfile.identifiers(locked: Identity): { [pkg_id.Identifier]: true }
	const identifiers: { [pkg_id.Identifier]: true } = {}

	for name, pkg in locked do
		identifiers[pkg_id.identifier(name, pkg.version)] = true
	end

	return identifiers
end

return table.freeze(lockfile)
